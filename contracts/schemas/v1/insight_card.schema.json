{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.example/v1/insight_card.schema.json",
  "title": "InsightCard",
  "description": "Schema-driven card rendered generically by the phone (and optionally the glasses display). Every value carries an epistemic label; calculated and estimated cards must cite calc_ids, observed cards must cite observations, educational cards must cite sources.",
  "type": "object",
  "required": ["schema", "card_id", "capability_id", "type", "title", "epistemic", "basis", "assumptions", "missing_data"],
  "properties": {
    "schema": { "const": "platform.insight_card/v1" },
    "card_id": { "$ref": "common.schema.json#/definitions/Ref" },
    "capability_id": { "$ref": "common.schema.json#/definitions/CapabilityId" },
    "type": { "type": "string", "enum": ["metric", "breakdown", "comparison", "list", "explanation", "consent"] },
    "title": { "$ref": "common.schema.json#/definitions/LText" },
    "primary": { "$ref": "#/definitions/CardValue" },
    "rows": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/definitions/CardRow" }
    },
    "body": { "$ref": "common.schema.json#/definitions/LText" },
    "epistemic": { "$ref": "common.schema.json#/definitions/Epistemic" },
    "data_mode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "basis": {
      "title": "CardBasis",
      "type": "object",
      "required": ["calc_ids", "as_of"],
      "properties": {
        "calc_ids": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Ref" } },
        "observation_ids": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Ref" } },
        "as_of": { "$ref": "common.schema.json#/definitions/Timestamp" },
        "sources": {
          "type": "array",
          "items": {
            "title": "CardSource",
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["calculation", "observation", "document"] },
              "ref": { "$ref": "common.schema.json#/definitions/Ref" },
              "title": { "type": "string", "maxLength": 200 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assumptions": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/LText" } },
    "missing_data": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/LText" } },
    "proposal_ids": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Ref" } },
    "receipt": { "$ref": "#/definitions/Receipt" },
    "render_hints": {
      "title": "RenderHints",
      "type": "object",
      "properties": {
        "glasses_display_lines": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 40 }
        },
        "voice_summary": { "$ref": "common.schema.json#/definitions/LText" },
        "sensitive": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "Receipt": {
      "title": "Receipt",
      "description": "The evidence behind a card (DEC-029): every input and result as a line with its source, how sure the answer is and why, how fresh the data is, and the platform's verification. The capability writes lines, confidence and freshness; only the platform writes verification, after the grounding verifier has passed.",
      "type": "object",
      "required": ["lines", "confidence", "freshness"],
      "properties": {
        "lines": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/definitions/ReceiptLine" } },
        "confidence": {
          "title": "ReceiptConfidence",
          "type": "object",
          "required": ["state", "reasons"],
          "properties": {
            "state": {
              "description": "confident: answered without reservations. caveated: answered, with reasons shown. abstained: no verdict was given, because the data could not support one.",
              "type": "string",
              "enum": ["confident", "caveated", "abstained"]
            },
            "reasons": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/ReceiptReason" } }
          },
          "additionalProperties": false
        },
        "freshness": {
          "title": "ReceiptFreshness",
          "type": "object",
          "required": ["as_of", "source", "simulated"],
          "properties": {
            "as_of": { "$ref": "common.schema.json#/definitions/Timestamp" },
            "source": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "simulated": { "description": "True for synthetic or fixture data, and for a simulated date.", "type": "boolean" }
          },
          "additionalProperties": false
        },
        "verification": {
          "title": "ReceiptVerification",
          "type": "object",
          "required": ["status", "checked_values", "calc_ids", "digest", "signature", "key_id", "signed_at"],
          "properties": {
            "status": { "type": "string", "enum": ["verified", "failed"] },
            "checked_values": { "type": "integer", "minimum": 0 },
            "calc_ids": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Ref" } },
            "digest": { "$ref": "common.schema.json#/definitions/Sha256" },
            "signature": { "description": "Compact JWS (ES256) by the platform over {card_id, digest, calc_ids, status, signed_at}.", "type": "string", "maxLength": 2000 },
            "key_id": { "type": "string", "maxLength": 100 },
            "signed_at": { "$ref": "common.schema.json#/definitions/Timestamp" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ReceiptLine": {
      "title": "ReceiptLine",
      "type": "object",
      "required": ["key", "label", "epistemic", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "$ref": "common.schema.json#/definitions/LText" },
        "money": { "$ref": "common.schema.json#/definitions/Money" },
        "text": { "type": "string", "maxLength": 200 },
        "epistemic": { "$ref": "common.schema.json#/definitions/Epistemic" },
        "source": { "type": "string", "enum": ["camera", "user", "engine", "coach", "platform", "fixture"] },
        "ref": { "$ref": "common.schema.json#/definitions/Ref" },
        "note": { "$ref": "common.schema.json#/definitions/LText" }
      },
      "additionalProperties": false
    },
    "ReceiptReason": {
      "title": "ReceiptReason",
      "type": "object",
      "required": ["code", "text", "blocks_verdict"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "text": { "$ref": "common.schema.json#/definitions/LText" },
        "blocks_verdict": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "CardValue": {
      "title": "CardValue",
      "type": "object",
      "required": ["label", "value", "epistemic"],
      "properties": {
        "label": { "$ref": "common.schema.json#/definitions/LText" },
        "value": {
          "anyOf": [
            { "$ref": "common.schema.json#/definitions/Money" },
            { "type": "string", "maxLength": 80 }
          ]
        },
        "epistemic": { "$ref": "common.schema.json#/definitions/Epistemic" }
      },
      "additionalProperties": false
    },
    "CardRow": {
      "title": "CardRow",
      "type": "object",
      "required": ["label", "value", "epistemic"],
      "properties": {
        "label": { "$ref": "common.schema.json#/definitions/LText" },
        "value": {
          "anyOf": [
            { "$ref": "common.schema.json#/definitions/Money" },
            { "type": "string", "maxLength": 80 }
          ]
        },
        "epistemic": { "$ref": "common.schema.json#/definitions/Epistemic" },
        "note": { "$ref": "common.schema.json#/definitions/LText" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$comment": "Calculated and estimated cards must cite at least one calc_id.",
      "if": { "properties": { "epistemic": { "enum": ["calculated", "estimate"] } }, "required": ["epistemic"] },
      "then": { "properties": { "basis": { "properties": { "calc_ids": { "minItems": 1 } } } } }
    },
    {
      "$comment": "Observed cards must cite the observation they are based on.",
      "if": { "properties": { "epistemic": { "const": "observed" } }, "required": ["epistemic"] },
      "then": { "properties": { "basis": { "required": ["observation_ids"], "properties": { "observation_ids": { "minItems": 1 } } } } }
    },
    {
      "$comment": "Educational cards must cite their sources.",
      "if": { "properties": { "epistemic": { "const": "educational" } }, "required": ["epistemic"] },
      "then": { "properties": { "basis": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } } } }
    }
  ],
  "patternProperties": { "^x_": {} },
  "additionalProperties": false
}
