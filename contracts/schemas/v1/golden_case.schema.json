{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.example/v1/golden_case.schema.json",
  "title": "GoldenCase",
  "description": "A test case a capability ships in its fixtures. The platform's fixture runner replays it through the adapter (any backend) and the deterministic fast path; registration fails if expected values differ or any spoken/card number is unverified.",
  "type": "object",
  "required": ["schema", "case_id", "capability_id", "tags", "persona", "today", "locale", "input", "expected"],
  "properties": {
    "schema": { "const": "platform.golden_case/v1" },
    "case_id": { "$ref": "common.schema.json#/definitions/Ref" },
    "capability_id": { "$ref": "common.schema.json#/definitions/CapabilityId" },
    "description": { "type": "string", "maxLength": 300 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["golden", "degraded", "injection", "capture", "confirmation", "locale"] }
    },
    "persona": { "description": "Path to a persona fixture, relative to the fixtures root.", "type": "string", "minLength": 1 },
    "today": { "$ref": "common.schema.json#/definitions/Timestamp" },
    "locale": { "$ref": "common.schema.json#/definitions/Locale" },
    "input": {
      "title": "GoldenInput",
      "type": "object",
      "required": ["utterance"],
      "properties": {
        "utterance": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "observations": { "type": "array", "items": { "$ref": "observation.schema.json" } },
        "capture_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "expected": {
      "title": "GoldenExpectation",
      "type": "object",
      "required": ["status", "intent", "tools", "values", "epistemic"],
      "properties": {
        "status": { "type": "string", "enum": ["answered", "partial", "clarify", "unsupported", "error"] },
        "intent": { "$ref": "common.schema.json#/definitions/IntentId" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "values": {
          "description": "Map of dotted path in the tool result (e.g. 'result.remaining_after.amount') to the exact expected string.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "epistemic": { "$ref": "common.schema.json#/definitions/Epistemic" },
        "data_mode": { "type": "string" },
        "speech_max_words": { "type": "integer", "minimum": 5, "maximum": 60 },
        "speech_must_mention": {
          "description": "Concepts the spoken line must convey, as machine codes the evaluator maps to checks (e.g. PRICE_IS_OBSERVED, ESTIMATE).",
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "proposal_kinds": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/ActionKind" } }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": { "^x_": {} },
  "additionalProperties": false
}
